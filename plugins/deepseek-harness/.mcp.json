{
  "mcpServers": {
    "deepseek-harness": {
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/dist/bin.mjs"
      ],
      "env_vars": [
        "DSH_MCP_MODE",
        "DSH_MCP_DATA_DIR",
        "DSH_MCP_WORKSPACE_ROOTS",
        "DSH_MCP_HARNESS_PACKAGE",
        "DSH_MCP_NPX_COMMAND",
        "DSH_PERMISSION_MODE",
        "DEEPSEEK_API_KEY",
        "DEEPSEEK_BASE_URL"
      ],
      "env": {
        "DSH_MCP_MODE": "desktop-attach"
      }
    }
  }
}
